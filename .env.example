# Database Configuration
# Local SQLite default for instant zero-config run:
DATABASE_URL="file:./dev.db"
# Or PostgreSQL for production / Docker:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/entropia?schema=public"

# OpenAI API Key for AI Reasoning Agent (runs with rich built-in heuristic reasoning fallback if not provided)
OPENAI_API_KEY=""

# Application Security
AUTH_SECRET="entropia-dev-secret-super-secure-key-32-chars"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Filecoin Modular Storage Network
FILECOIN_API_URL="https://api.node.glif.io/rpc/v1"
FILECOIN_API_KEY="mock-filecoin-api-key"
